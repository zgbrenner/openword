{
  "name": "openword",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, open-source word processor built on one LibreOffice Writer engine.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:desktop": "npm run engine:verify && npm run build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "engine:lock": "node engine/scripts/resolve-runtime.mjs",
    "engine:prepare": "node engine/scripts/prepare-sources.mjs",
    "engine:build": "bash engine/scripts/build-runtime.sh",
    "engine:verify": "node engine/scripts/verify-runtime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.8",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "orderedmap": "^2.1.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.3",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.7.1",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.40.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.1",
    "@tsconfig/svelte": "^5.0.5",
    "svelte": "^5.44.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
