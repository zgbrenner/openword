{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWord",
  "version": "0.1.0",
  "identifier": "org.openword.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenWord",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["owdoc"],
        "name": "OpenWord Document",
        "description": "OpenWord native document",
        "role": "Editor"
      },
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Microsoft Word document",
        "role": "Editor"
      }
    ]
  }
}
