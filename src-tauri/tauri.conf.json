{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWord",
  "version": "0.1.0",
  "identifier": "org.openword.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenWord",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff"
      },
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["owdoc"],
        "name": "Legacy OpenWord Document",
        "description": "Legacy OpenWord document for migration",
        "role": "Editor"
      },
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Microsoft Word document",
        "role": "Editor"
      },
      {
        "ext": ["odt"],
        "name": "OpenDocument Text",
        "description": "OpenDocument text document",
        "role": "Editor"
      }
    ]
  }
}
