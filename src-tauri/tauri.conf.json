{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWord",
  "version": "0.1.0",
  "identifier": "org.openword.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenWord",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff"
      },
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "OpenWord contributors",
    "homepage": "https://github.com/zgbrenner/openword",
    "copyright": "Copyright © 2026 OpenWord contributors. Licensed under the Apache License, Version 2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "A free, open-source, genuinely lightweight word processor.",
    "longDescription": "OpenWord is a local-first word processor. It opens, edits and saves Word (.docx) documents entirely on your own machine, with pagination, tables, images, comments and tracked changes. The application makes no network requests of any kind: there is no telemetry, no account, and no cloud service behind it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "owdoc"
        ],
        "name": "OpenWord.owdoc",
        "description": "Legacy OpenWord Document",
        "role": "Editor"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "OpenWord.docx",
        "description": "Microsoft Word Document",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
